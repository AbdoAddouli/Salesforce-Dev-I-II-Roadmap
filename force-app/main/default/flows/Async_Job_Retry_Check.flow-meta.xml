<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Async_Job_Retry_Check</label>
    <processType>AutoLaunchedFlow</processType>
    <schedule>
        <frequency>Day</frequency>
        <startDate>2026-01-01</startDate>
        <startTime>22:00:00.000Z</startTime>
    </schedule>
    <start>
        <connector>
            <targetReference>Get_Failed_Jobs</targetReference>
        </connector>
    </start>
    <recordLookups>
        <name>Get_Failed_Jobs</name>
        <object>Async_Job_Monitor__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Retry_Count__c</queriedFields>
        <queriedFields>Job_Status__c</queriedFields>
        <filters>
            <field>Job_Status__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Failed</stringValue></value>
        </filters>
        <filters>
            <field>Retry_Count__c</field>
            <operator>LessThan</operator>
            <value><numberValue>3</numberValue></value>
        </filters>
        <getFirstOnly>false</getFirstOnly>
    </recordLookups>
    <loops>
        <name>Loop_Jobs</name>
        <iterationVariable>Get_Failed_Jobs</iterationVariable>
        <nextValueConnector>
            <targetReference>Calc_New_Retry</targetReference>
        </nextValueConnector>
    </loops>
    <assignments>
        <name>Calc_New_Retry</name>
        <assignmentItems>
            <assignToReference>New_Retry_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Jobs.CurrentItem.Retry_Count__c</elementReference>
            </value>
            <value>
                <numberValue>1</numberValue>
            </value>
        </assignmentItems>
    </assignments>
    <recordUpdates>
        <name>Mark_Retrying</name>
        <inputReference>Loop_Jobs.CurrentItem</inputReference>
        <outputAssignments>
            <name>Job_Status__c</name>
            <value><stringValue>Retrying</stringValue></value>
        </outputAssignments>
        <outputAssignments>
            <name>Retry_Count__c</name>
            <value><elementReference>New_Retry_Count</elementReference></value>
        </outputAssignments>
    </recordUpdates>
    <variables>
        <name>New_Retry_Count</name>
        <dataType>Number</dataType>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
