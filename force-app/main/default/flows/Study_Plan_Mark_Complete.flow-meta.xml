<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Study_Plan_Mark_Complete</label>
    <processType>RecordFlow</processType>
    <start>
        <connector>
            <targetReference>Check_Progress</targetReference>
        </connector>
        <object>Study_Plan__c</object>
        <filterType>Update</filterType>
    </start>
    <decisions>
        <name>Check_Progress</name>
        <defaultConnector>
            <targetReference>Done</targetReference>
        </defaultConnector>
        <rules>
            <name>Reached_100</name>
            <conditions>
                <leftValue><elementReference>$Record.Progress__c</elementReference></leftValue>
                <operator>GreaterThanOrEqual</operator>
                <rightValue><numberValue>100</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Completed</targetReference>
            </connector>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Set_Completed</name>
        <inputReference>$Record</inputReference>
        <outputAssignments>
            <name>Status__c</name>
            <value><stringValue>Completed</stringValue></value>
        </outputAssignments>
    </recordUpdates>
</Flow>
