<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Dev_Task_Default_Priority</label>
    <processType>RecordFlow</processType>
    <start>
        <connector>
            <targetReference>Decide_Priority</targetReference>
        </connector>
        <object>Dev_Task__c</object>
        <filterType>Insert</filterType>
    </start>
    <decisions>
        <name>Decide_Priority</name>
        <defaultConnector>
            <targetReference>Set_Normal</targetReference>
        </defaultConnector>
        <rules>
            <name>Practice_Code</name>
            <conditions>
                <leftValue><elementReference>$Record.Task_Type__c</elementReference></leftValue>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Practice Code</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_High</targetReference></connector>
        </rules>
        <rules>
            <name>Read_Guide</name>
            <conditions>
                <leftValue><elementReference>$Record.Task_Type__c</elementReference></leftValue>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Read Guide</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_Medium</targetReference></connector>
        </rules>
        <rules>
            <name>Hands_On</name>
            <conditions>
                <leftValue><elementReference>$Record.Task_Type__c</elementReference></leftValue>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Hands-on Challenge</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_High</targetReference></connector>
        </rules>
    </decisions>
    <assignments>
        <name>Set_High</name>
        <assignmentItems>
            <assignToReference>$Record.Priority__c</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>High</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Medium</name>
        <assignmentItems>
            <assignToReference>$Record.Priority__c</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Medium</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Normal</name>
        <assignmentItems>
            <assignToReference>$Record.Priority__c</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Normal</stringValue></value>
        </assignmentItems>
    </assignments>
</Flow>
