<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Integration_Log_Inbound_Flag</label>
    <processType>RecordFlow</processType>
    <start>
        <connector>
            <targetReference>Direction_Check</targetReference>
        </connector>
        <object>Integration_Log__c</object>
        <filterType>Insert</filterType>
    </start>
    <decisions>
        <name>Direction_Check</name>
        <defaultConnector>
            <targetReference>Done</targetReference>
        </defaultConnector>
        <rules>
            <name>Inbound</name>
            <conditions>
                <leftValue><elementReference>$Record.Direction__c</elementReference></leftValue>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Inbound</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Detect_API_Type</targetReference></connector>
        </rules>
    </decisions>
    <decisions>
        <name>Detect_API_Type</name>
        <defaultConnector>
            <targetReference>Set_Other_Type</targetReference>
        </defaultConnector>
        <rules>
            <name>REST</name>
            <conditions>
                <leftValue><elementReference>$Record.Endpoint__c</elementReference></leftValue>
                <operator>Contains</operator>
                <rightValue><stringValue>/services/data</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_REST_Type</targetReference></connector>
        </rules>
        <rules>
            <name>SOAP</name>
            <conditions>
                <leftValue><elementReference>$Record.Endpoint__c</elementReference></leftValue>
                <operator>Contains</operator>
                <rightValue><stringValue>/services/Soap</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_SOAP_Type</targetReference></connector>
        </rules>
        <rules>
            <name>Bulk</name>
            <conditions>
                <leftValue><elementReference>$Record.Endpoint__c</elementReference></leftValue>
                <operator>Contains</operator>
                <rightValue><stringValue>/services/async</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_Bulk_Type</targetReference></connector>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Set_REST_Type</name>
        <inputReference>$Record</inputReference>
        <outputAssignments>
            <name>Integration_Type__c</name>
            <value><stringValue>REST API</stringValue></value>
        </outputAssignments>
    </recordUpdates>
    <recordUpdates>
        <name>Set_SOAP_Type</name>
        <inputReference>$Record</inputReference>
        <outputAssignments>
            <name>Integration_Type__c</name>
            <value><stringValue>SOAP API</stringValue></value>
        </outputAssignments>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Bulk_Type</name>
        <inputReference>$Record</inputReference>
        <outputAssignments>
            <name>Integration_Type__c</name>
            <value><stringValue>Bulk API</stringValue></value>
        </outputAssignments>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Other_Type</name>
        <inputReference>$Record</inputReference>
        <outputAssignments>
            <name>Integration_Type__c</name>
            <value><stringValue>Other</stringValue></value>
        </outputAssignments>
    </recordUpdates>
</Flow>
