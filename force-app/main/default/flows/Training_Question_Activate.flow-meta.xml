<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Training_Question_Activate</label>
    <processType>RecordFlow</processType>
    <start>
        <connector>
            <targetReference>Check_Active</targetReference>
        </connector>
        <object>Training_Question__c</object>
        <filterType>Insert</filterType>
    </start>
    <decisions>
        <name>Check_Active</name>
        <defaultConnector>
            <targetReference>Decide_Difficulty</targetReference>
        </defaultConnector>
        <rules>
            <name>Not_Active</name>
            <conditions>
                <leftValue><elementReference>$Record.Is_Active__c</elementReference></leftValue>
                <operator>IsNull</operator>
            </conditions>
            <connector>
                <targetReference>Set_Active</targetReference>
            </connector>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Active</name>
        <assignmentItems>
            <assignToReference>$Record.Is_Active__c</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Decide_Difficulty</name>
        <defaultConnector>
            <targetReference>Done</targetReference>
        </defaultConnector>
        <rules>
            <name>Advanced</name>
            <conditions>
                <leftValue><elementReference>$Record.Blueprint_Weight__c</elementReference></leftValue>
                <operator>GreaterThanOrEqual</operator>
                <rightValue><numberValue>4</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Advanced</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Intermediate</name>
            <conditions>
                <leftValue><elementReference>$Record.Blueprint_Weight__c</elementReference></leftValue>
                <operator>GreaterThanOrEqual</operator>
                <rightValue><numberValue>2</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Intermediate</targetReference>
            </connector>
        </rules>
    </decisions>
    <assignments>
        <name>Set_Advanced</name>
        <assignmentItems>
            <assignToReference>$Record.Difficulty__c</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Advanced</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Intermediate</name>
        <assignmentItems>
            <assignToReference>$Record.Difficulty__c</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Intermediate</stringValue></value>
        </assignmentItems>
    </assignments>
</Flow>
